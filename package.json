{
  "name": "bridger-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:contracts": "npm run build -w @bridger/contracts",
    "dev:api": "npm run build:contracts && npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build:contracts && npm run build -w api && npm run build -w web",
    "lint": "npm run lint -w web --if-present",
    "prisma:migrate:dev": "npm run prisma:migrate:dev -w web",
    "prisma:studio": "npm run prisma:studio -w web",
    "prisma:format": "npm run prisma:format -w web",
    "prisma:seed": "npm run prisma:seed -w web"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
